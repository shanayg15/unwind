# UNDO configuration (names used by the code). Placeholders only; real values live in an ignored .env.
# Deployment
APP_BASE_URL=https://<your-server>.run.mcp-use.com
MCP_PUBLIC_URL=https://<your-server>.run.mcp-use.com/mcp
PUBLIC_DEMO_STORE_ID=store_demo
# Postgres (Neon). Tests refuse to run without a separate test branch.
DATABASE_URL=
DATABASE_URL_TEST=
DB_POOL_MAX=5
# Model used by the local agent worker (Claude Agent SDK on the local Claude login)
MODEL_ID=claude-opus-5-5
# Inkbox: one shop identity (owner iMessage/voice + customer email) and the signed webhook receiver
INKBOX_API_KEY=
INKBOX_IDENTITY=
INKBOX_WEBHOOK_SECRET=
INKBOX_WEBHOOK_AUTH_TOKEN=
# Consented test contacts (private; never committed)
OWNER_PHONE_E164=
CUSTOMER_TEST_EMAIL=
# Live-send gates and budgets (default deny)
LIVE_SEND_ENABLED=false
MAX_LIVE_MESSAGES=0
OWNER_VOICE_ENABLED=false
MAX_LIVE_CALLS=0
MAX_CALL_DURATION_SECONDS=180
# Armature (optional; evals/ARMATURE_SETUP.md)
ARMATURE_API_KEY=

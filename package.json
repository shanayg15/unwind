{
  "name": "undo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UNWIND: rollback for ecommerce agents that keeps customer promises (commerce-aware recovery MCP)",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "setup:check": "tsx --env-file-if-exists=.env scripts/setup-check.ts",
    "dev": "mcp-use dev --port 3000",
    "build": "mcp-use build",
    "start": "mcp-use start",
    "typecheck": "mcp-use typecheck && tsc -p tsconfig.tools.json",
    "lint": "tsc -p tsconfig.tools.json --noUnusedLocals --noUnusedParameters",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "UNDO_ALLOW_RESET=1 tsx --env-file-if-exists=.env scripts/e2e.ts",
    "test:mcp": "tsx --env-file-if-exists=.env scripts/mcp-probe.ts",
    "test:providers": "tsx --env-file-if-exists=.env scripts/provider-smoke.ts",
    "eval:agent": "tsx --env-file-if-exists=.env harness/eval-agent.ts",
    "deploy": "tsx --env-file-if-exists=.env scripts/deploy.ts",
    "smoke:deployed": "tsx --env-file-if-exists=.env scripts/smoke-deployed.ts",
    "demo:reset": "UNDO_ALLOW_RESET=1 tsx --env-file-if-exists=.env scripts/seed.ts",
    "demo:launch": "tsx --env-file-if-exists=.env harness/launch-agent.ts",
    "demo:activity": "tsx --env-file-if-exists=.env scripts/demo-activity.ts",
    "demo:verify": "tsx --env-file-if-exists=.env scripts/demo-verify.ts",
    "worker": "tsx --env-file-if-exists=.env worker/agent-worker.ts",
    "verify:all": "tsx --env-file-if-exists=.env scripts/verify-all.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "eval:fixture": "UNDO_ALLOW_RESET=1 tsx --env-file-if-exists=.env scripts/eval-fixture.ts"
  },
  "dependencies": {
    "@inkbox/sdk": "^0.7.19",
    "hono": "4.13.13",
    "mcp-use": "2.10.1",
    "pg": "8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@mcp-use/client": "^2.4.4",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
